


model Product {
  id String @id @default(cuid())

  name        String
  code        String @unique
  sku         String?
  description String?

  brandId     String?
  categoryIds String[]
  unitId      String?
  taxId       String?

  hsnCode       String?
  manufacturer  String?
  originCountry String?

  hasVariants    Boolean @default(false)
  trackInventory Boolean @default(true)
  allowBackorder Boolean @default(false)




  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    // 1. One-to-One: Thumbnail Relation
  thumbnailImageId String?       @unique // @unique is required for 1-to-1 in Prisma
  thumbnailImage   ProductImage? @relation("ThumbnailImage", fields: [thumbnailImageId], references: [id], onDelete: SetNull)

  // 2. One-to-One: Hero Relation
  heroImageId      String?       @unique // @unique is required for 1-to-1 in Prisma
  heroImage        ProductImage? @relation("HeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)

  // 3. One-to-Many: Gallery Relation
  // We drop the flat String[] array so PostgreSQL can index the relation natively
  galleryImages    ProductImage[] @relation("GalleryImages")

  brand Brand? @relation(fields: [brandId], references: [id])
  unit  Unit?  @relation(fields: [unitId], references: [id])
  tax   Tax?   @relation(fields: [taxId], references: [id])

  variants ProductVariant[]
}



model ProductVariant {
  id        String   @id @default(cuid())
  productId String

  name String?
  sku  String

  isActive Boolean @default(true)

  // One-to-One relations for Single Image Positions
  thumbnailImageId String?       @unique
  thumbnailImage   ProductImage? @relation("VariantThumbnail", fields: [thumbnailImageId], references: [id], onDelete: SetNull)

  heroImageId      String?       @unique
  heroImage        ProductImage? @relation("VariantHero", fields: [heroImageId], references: [id], onDelete: SetNull)

  // One-to-Many relation for Gallery Images
  galleryImages    ProductImage[] @relation("VariantGallery")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes VariantAttribute[]
  barcodes   Barcode[]
  prices     ProductPrice[]
}

model VariantAttribute {
  id               String         @id @default(cuid())
  variantId        String
  attributeId      String
  attributeValueId String
  attribute        Attribute      @relation(fields: [attributeId], references: [id])
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  path String

  // Back-reference for the One-to-Many gallery
  product      Product  @relation("GalleryImages", fields: [productId], references: [id], onDelete: Cascade)

  // Back-references for the One-to-One single images
  thumbnailFor Product? @relation("ThumbnailImage")
  heroFor      Product? @relation("HeroImage")

  // NEW: Variant relational back-references
  variantGalleryFor ProductVariant? @relation("VariantGallery", fields: [variantId], references: [id])
  variantId         String? // Optional field to link images to a specific variant
  
  variantThumbnailFor ProductVariant? @relation("VariantThumbnail")
  variantHeroFor      ProductVariant? @relation("VariantHero")
}

model Barcode {
  id        String         @id @default(cuid())
  variantId String
  barcode   String         @unique
  type      BarcodeType    @default(CODE128)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model PriceList {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  currencyId  String
  description String?
  isDefault   Boolean        @default(false)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  currency    Currency       @relation(fields: [currencyId], references: [id])
  prices      ProductPrice[]
}

model ProductPrice {
  id            String         @id @default(cuid())
  variantId     String
  priceListId   String
  price         Decimal        @db.Decimal(10, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  priceList     PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, priceListId])
}

enum BarcodeType {
  EAN13
  CODE128
  UPC
  QR
}
