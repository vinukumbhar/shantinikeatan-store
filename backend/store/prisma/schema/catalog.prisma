model Product {
  id String @id @default(cuid())

  name        String
  code        String  @unique
  sku         String?
  description String?

  brandId     String?
  categoryIds String[]
  unitId      String?
  taxId       String?

  hsnCode       String?
  manufacturer  String?
  originCountry String?

  hasVariants    Boolean @default(false)
  trackInventory Boolean @default(true)
  allowBackorder Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1. One-to-One: Thumbnail Relation
  thumbnailImageId String?       @unique // @unique is required for 1-to-1 in Prisma
  thumbnailImage   ProductImage? @relation("ThumbnailImage", fields: [thumbnailImageId], references: [id], onDelete: SetNull)

  // 2. One-to-One: Hero Relation
  heroImageId String?       @unique // @unique is required for 1-to-1 in Prisma
  heroImage   ProductImage? @relation("HeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)

  // 3. One-to-Many: Gallery Relation
  // We drop the flat String[] array so PostgreSQL can index the relation natively
  galleryImages ProductImage[] @relation("GalleryImages")

  brand Brand? @relation(fields: [brandId], references: [id])
  unit  Unit?  @relation(fields: [unitId], references: [id])
  tax   Tax?   @relation(fields: [taxId], references: [id])

  variants ProductVariant[]

  priceListItems PriceListItem[]
}


model ProductVariant {
  id        String @id @default(cuid())
  productId String

  name String?
  sku  String

  isActive Boolean @default(true)

  // Inventory
  stock         Int @default(0)
  lowStockLimit Int @default(0)

  // Variant Thumbnail
  thumbnailImageId String?
  thumbnailImage   ProductImage? @relation("VariantThumbnail", fields: [thumbnailImageId], references: [id], onDelete: SetNull)

  // Variant Hero
  heroImageId String?
  heroImage   ProductImage? @relation("VariantHero", fields: [heroImageId], references: [id], onDelete: SetNull)

  // Variant Gallery
  galleryImages ProductImage[] @relation("VariantGallery")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes VariantAttribute[]
  barcodes   Barcode[]
  prices     PriceListItem[]
}

model VariantAttribute {
  id               String         @id @default(cuid())
  variantId        String
  attributeId      String
  attributeValueId String
  attribute        Attribute      @relation(fields: [attributeId], references: [id])
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
}



model ProductImage {
  id String @id @default(cuid())

  productId String
  path      String

  // Product Gallery
  product Product @relation("GalleryImages", fields: [productId], references: [id], onDelete: Cascade)

  // Product Thumbnail / Hero
  thumbnailFor Product? @relation("ThumbnailImage")
  heroFor      Product? @relation("HeroImage")

  // Variant Gallery
  variantId         String?
  variantGalleryFor ProductVariant? @relation("VariantGallery", fields: [variantId], references: [id])

  // Variant Thumbnail
  // Same image can be used by multiple variants
  variantThumbnailFor ProductVariant[] @relation("VariantThumbnail")

  // Variant Hero
  // Same image can be used by multiple variants
  variantHeroFor ProductVariant[] @relation("VariantHero")
}

model Barcode {
  id        String         @id @default(cuid())
  variantId String
  barcode   String         @unique
  type      BarcodeType    @default(CODE128)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model PriceList {
  id String @id @default(cuid())

  name      String
  invoiceId String?
  poId      String?
  number    String  @unique

  date DateTime @default(now())

  approvedById String?
  //approvedBy   User? @relation(fields: [approvedById], references: [id])

  items PriceListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceListItem {
  id String @id @default(cuid())

  priceListId String
  productId   String
  variantId   String?

  stock        Int
  sellingPrice Float
  costPrice    Float
  mrp          Float

  priceList PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  currencyId String?

  currency Currency? @relation(fields: [currencyId], references: [id])

  @@index([priceListId])
  @@index([productId])
  @@index([variantId])
}

enum BarcodeType {
  EAN13
  CODE128
  UPC
  QR
}
